APP_NAME=LMS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR_HOSTNAME
APP_TIMEZONE=Asia/Colombo
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=YOUR_RDS_ENDPOINT
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=lms_app
DB_PASSWORD="YOUR_STRONG_DB_PASSWORD"
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
LOG_CHANNEL=stack
LOG_LEVEL=warning

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_HOSTNAME/auth/google/callback

STRIPE_KEY=
STRIPE_SECRET=
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
VIMEO_ACCESS_TOKEN=

VITE_APP_NAME=LMS
