#!/usr/bin/env bash
set -Eeuo pipefail

# SSM runs commands as root. The actual application steps run as lmsdeploy.
exec 9>/var/lock/lms-deploy.lock
flock -n 9 || { echo 'A deployment is already running.'; exit 1; }

APP_DIR=/var/www/lms
DEPLOY_USER=lmsdeploy
[[ -f "$APP_DIR/.env" ]] || { echo "Missing $APP_DIR/.env" >&2; exit 1; }
[[ -d "$APP_DIR/.git" ]] || { echo "Missing Git checkout in $APP_DIR" >&2; exit 1; }

runuser -u "$DEPLOY_USER" -- /bin/bash -c '
set -Eeuo pipefail
umask 0002
cd /var/www/lms

git fetch --prune origin main
git reset --hard origin/main

composer install --no-dev --prefer-dist --no-interaction --no-progress --optimize-autoloader
npm ci --no-audit --no-fund
npm run build

# A hot file forces Vite development mode; never leave it on production.
rm -f public/hot
php artisan config:clear
php artisan migrate --force
php artisan storage:link
php artisan config:cache
php artisan event:cache
php artisan view:cache
# Do not route:cache here until closure routes have been reviewed.
php artisan queue:restart
'

systemctl restart lms-queue.service
systemctl restart lms-ssr.service
systemctl reload php8.3-fpm.service

# Nginx must already be configured for the selected hostname.
curl --fail --silent --show-error --retry 6 --retry-delay 2 \
  -H 'Host: YOUR_HOSTNAME' http://127.0.0.1/up >/dev/null

echo 'LMS deployment finished; local /up responded successfully.'
