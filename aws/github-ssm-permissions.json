{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployLmsOnlyOnSelectedInstance",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand"],
      "Resource": [
        "arn:aws:ssm:ap-southeast-2:AWS_ACCOUNT_ID:document/LMS-Deploy",
        "arn:aws:ec2:ap-southeast-2:AWS_ACCOUNT_ID:instance/EC2_INSTANCE_ID"
      ]
    },
    {
      "Sid": "ReadDeploymentResult",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation"],
      "Resource": "*"
    }
  ]
}
